#version 450
// y += 1; repeated dispatches in one run() exercise the compute barriers.
layout(local_size_x = 256) in;

layout(binding = 0) buffer Y { float y[]; };

layout(push_constant) uniform Params {
    uint n;
} pc;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i < pc.n) {
        y[i] += 1.0;
    }
}
