#version 450
// Samples a 2D image with a combined image sampler. For each requested
// coordinate (normalised UV, origin top-left as in Vulkan), writes one float.
//
// The test kernel is bounds-checked: samples outside the requested count are
// discarded, and the same sampler state the host built is what the shader uses
// (no implicit filtering beyond the sampler).
layout(local_size_x = 64) in;

layout(binding = 0) buffer Out { float values[]; };

layout(binding = 1) uniform sampler2D source_image;

layout(push_constant) uniform Params {
    uint count;      // number of samples to write
    uint stride;     // coords are 2 floats each in the XY buffer
    float scale;     // multiplied into the result (lets a test ask for raw or scaled)
} pc;

layout(binding = 2) buffer UV { float coords[]; };

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.count) {
        return;
    }
    // Coords are tightly packed pairs; the bound check keeps a mis-sized
    // buffer from reading past its end (base + 1 <= stride * count - 1).
    uint base = i * pc.stride;
    if (base + 1 >= pc.stride * pc.count) {
        return;
    }
    vec2 uv = vec2(coords[base], coords[base + 1]);
    // Bounds check: a coordinate outside [0, 1] is sampled (the sampler's
    // address mode decides the result), so no clamp here — that is exactly what
    // ClampToEdge/Repeat tests exercise.
    vec4 texel = texture(source_image, uv);
    values[i] = texel.r * pc.scale;
}
