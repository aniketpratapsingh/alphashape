{
  "$schema": "alphashape-design-tokens/1",
  "meta": {
    "version": "0.2.0",
    "updated": "2026-10-21",
    "units": { "font": "px", "space": "px", "radius": "px", "motion": "ms" },
    "notes": "Semantic tokens. Dark is default. The accent is one swappable token family (accent.base / hover / pressed / text / subtle / onAccent + selection + chip border) with three variants: teal (default), ember, copper. `color.accentVariants` is the source of truth for the family; the `dark`/`light` blocks below mirror the default (teal) so existing consumers keep working. Status colours are part of the variant because an orange accent must move warning to gold and error to rose. QSS has no CSS variables: values are compiled to stylesheets (see qt-mapping.md)."
  },

  "color": {
    "accentVariants": {
      "_note": "Swappable accent family. Each theme's status colours move with the accent so chips never collide with it.",
      "teal": {
        "dark":  { "base": "#35BDAF", "hover": "#48CBBE", "pressed": "#2AA79B", "text": "#4FD1C3", "subtle": "#16302E", "onAccent": "#04211E",
                   "selection": "#1E3F3C", "chipBorder": "#22443F",
                   "status": { "warning": "#E3A33C", "warningBg": "#2A2214", "error": "#F07068", "errorBg": "#2E1917" } },
        "light": { "base": "#0E7C72", "hover": "#0B6E66", "pressed": "#085B55", "text": "#0B6E66", "subtle": "#DDF1EE", "onAccent": "#FFFFFF",
                   "selection": "#CFEAE6", "chipBorder": "#A9D8D2",
                   "status": { "warning": "#8A5A00", "warningBg": "#F8EEDC", "error": "#B3261E", "errorBg": "#F9E5E3" } }
      },
      "ember": {
        "dark":  { "base": "#C2410C", "hover": "#CC4A15", "pressed": "#A93608", "text": "#F08A58", "subtle": "#331A0E", "onAccent": "#FFFFFF",
                   "selection": "#3A1D12", "chipBorder": "#5E2A12",
                   "status": { "warning": "#EAC65A", "warningBg": "#2C2712", "error": "#F4738B", "errorBg": "#2E191F" } },
        "light": { "base": "#A83A0E", "hover": "#B64313", "pressed": "#8F2F08", "text": "#9A3409", "subtle": "#F8E6DC", "onAccent": "#FFFFFF",
                   "selection": "#F3D5C7", "chipBorder": "#E7B79F",
                   "status": { "warning": "#6B5200", "warningBg": "#F7EFD4", "error": "#A81E45", "errorBg": "#F9E5EC" } }
      },
      "copper": {
        "dark":  { "base": "#C0873F", "hover": "#CB9550", "pressed": "#B57C33", "text": "#DFAE72", "subtle": "#2E2417", "onAccent": "#1F1305",
                   "selection": "#37291A", "chipBorder": "#5A4526",
                   "status": { "warning": "#D8E45A", "warningBg": "#282812", "error": "#F4738B", "errorBg": "#2E191F" } },
        "light": { "base": "#8F5C1F", "hover": "#9C6624", "pressed": "#7A4D18", "text": "#7E5219", "subtle": "#F5E9D6", "onAccent": "#FFFFFF",
                   "selection": "#EFDDC1", "chipBorder": "#DCC59A",
                   "status": { "warning": "#545C00", "warningBg": "#F0F0D5", "error": "#A81E45", "errorBg": "#F9E5EC" } }
      }
    },
    "viewport": {
      "_note": "The 3D canvas is its own instrument pane with two modes, independent of the app theme. Cameras/GCPs follow the accent family: warm (teal accent) keeps yellow cameras; cool (ember/copper) moves cameras to sky-cyan and GCPs to white core + orange ring. 'Follow theme' maps dark chrome->dark canvas, light chrome->light canvas.",
      "dark": {
        "bgGradient": ["#243038", "#1D252B", "#141B20"],
        "grid": "#6B8391", "boundingBox": "#5FA79C",
        "pointTie": "#A9C6D4", "pointTieOpacity": 0.55,
        "points": [["#9DB2BE", 0.75], ["#A9C6D4", 0.9], ["#DCEBF3", 0.9]],
        "entities": {
          "warm": { "camera": "#F2C94C", "cameraOpacity": 0.55, "gcp": "#F2994A", "gcpStyle": "filled", "gcpLabel": "#F5C08C" },
          "cool": { "camera": "#5BC8E8", "cameraOpacity": 0.7, "gcp": "#FFFFFF", "gcpRing": "#FF9E52", "gcpStyle": "ring", "gcpLabel": "#F5C08C" }
        },
        "toolbar": { "bg": "#121A1F", "text": "#A7B4BC", "border": "#33414B" },
        "card": { "bg": "#141C21", "bg2": "#10171B", "text": "#E8EEF1", "secondary": "#A7B4BC", "tertiary": "#9AA7AE" }
      },
      "light": {
        "bgGradient": ["#FAFBFC", "#EDF1F2", "#E2E8EA"],
        "grid": "#64717A", "boundingBox": "#5E6B73",
        "pointTie": "#56646C", "pointTieOpacity": 0.85,
        "points": [["#6F7C84", 1], ["#46545B", 0.95], ["#162026", 0.95]],
        "entities": {
          "warm": { "camera": "#7A5C00", "cameraOpacity": 1, "gcp": "#8A4A0A", "gcpStyle": "filled", "gcpLabel": "#5A3510" },
          "cool": { "camera": "#0F5D78", "cameraOpacity": 1, "gcp": "#FFFFFF", "gcpRing": "#8A4A0A", "gcpStyle": "ring", "gcpLabel": "#5A3510" }
        },
        "toolbar": { "bg": "#FBFCFD", "text": "#4C5B63", "border": "#C7D0D4" },
        "card": { "bg": "#FFFFFF", "text": "#101619", "secondary": "#4C5B63", "tertiary": "#5C6A72" }
      }
    },
