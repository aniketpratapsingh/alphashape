  "font": {
    "family": {
      "ui":       "Inter",
      "mono":     "JetBrains Mono",
      "fallback": ["-apple-system", "Segoe UI", "Roboto", "Helvetica Neue", "sans-serif"]
    },
    "size": {
      "micro":    10,
      "xs":       11,
      "sm":       12,
      "base":     13,
      "md":       14,
      "lg":       16,
      "xl":       20,
      "2xl":      26
    },
    "lineHeight": {
      "micro":    14,
      "xs":       15,
      "sm":       17,
      "base":     19,
      "md":       20,
      "lg":       23,
      "xl":       27,
      "2xl":      32
    },
    "weight": {
      "regular":  400,
      "medium":   500,
      "semibold": 600
    },
    "letterSpacing": {
      "tight":    "-0.006em",
      "normal":   "0",
      "caps":     "0.055em"
    },
    "numeric": {
      "feature":  "tabular-nums",
      "note":     "All tables, coordinates, errors, durations, and estimates use tabular figures. Mono is reserved for coordinates, ids, and console."
    }
  },

  "space": {
    "0": 0, "1": 2, "2": 4, "3": 6, "4": 8, "5": 12, "6": 16, "7": 20, "8": 24, "9": 32, "10": 40
  },

  "radius": { "xs": 2, "sm": 3, "md": 4, "lg": 6, "pill": 999 },

  "border": { "hairline": 1, "focus": 2 },

  "elevation": {
    "none":   "none",
    "panel":  "0 1px 0 rgba(0,0,0,0.35) inset",
    "overlay":"0 8px 24px rgba(0,0,0,0.45), 0 0 0 1px rgba(255,255,255,0.06)",
    "dialog": "0 16px 48px rgba(0,0,0,0.55), 0 0 0 1px rgba(255,255,255,0.07)",
    "light": {
      "panel":   "0 1px 0 rgba(0,0,0,0.06) inset",
      "overlay": "0 8px 24px rgba(16,22,25,0.16), 0 0 0 1px rgba(16,22,25,0.08)",
      "dialog":  "0 16px 48px rgba(16,22,25,0.22), 0 0 0 1px rgba(16,22,25,0.10)"
    }
  },

  "motion": {
    "instant":  0,
    "fast":     120,
    "base":     180,
    "slow":     260,
    "easing":   "cubic-bezier(0.2, 0, 0, 1)",
    "notes":    "Motion is limited to opacity/color for hover and focus, and height for disclosures. No layout animation on docks or panels. Respects 'reduce motion' by snapping durations to 0."
  },

  "size": {
    "controlHeight":  24,
    "controlHeightLg":28,
    "rowHeight":      22,
    "treeRowHeight":  22,
    "toolbarHeight":  36,
    "statusHeight":   26,
    "dockTitleHeight":30,
    "dockMinWidth":   220,
    "sidebarWidth":   268,
    "stageRailWidth": 44,
    "icons": { "sm": 14, "md": 16, "lg": 20 }
  },

  "type": {
    "ui":        { "family": "ui",   "size": "base",  "weight": "regular",  "lineHeight": "base" },
    "uiStrong":  { "family": "ui",   "size": "base",  "weight": "semibold", "lineHeight": "base" },
    "secondary": { "family": "ui",   "size": "sm",    "weight": "regular",  "lineHeight": "sm", "color": "secondary" },
    "label":     { "family": "ui",   "size": "xs",    "weight": "medium",   "lineHeight": "xs", "letterSpacing": "caps", "textTransform": "uppercase" },
    "title":     { "family": "ui",   "size": "md",    "weight": "semibold", "lineHeight": "md" },
    "dialogTitle": { "family": "ui", "size": "lg",    "weight": "semibold", "lineHeight": "lg" },
    "numeric":   { "family": "ui",   "size": "sm",    "weight": "regular",  "lineHeight": "sm", "fontFeature": "tabular-nums" },
    "coordinate":{ "family": "mono", "size": "xs",    "weight": "regular",  "lineHeight": "xs" },
    "console":   { "family": "mono", "size": "xs",    "weight": "regular",  "lineHeight": "xs" }
  }
}
