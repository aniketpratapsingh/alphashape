/* alphashape dark — generated from design/system/tokens.json
 * QSS only: no variables, calc(), flex, grid, transitions or box-shadow.
 * Accent = selected/primary only. Status colors are reserved for status. */

QWidget {
    background-color: #0D1114;
    color: #E8EEF1;
    font-family: "Inter", "Segoe UI", "Helvetica Neue", sans-serif;
    font-size: 13px;
}
QMainWindow, QWidget#appBackground { background-color: #0D1114; }
QWidget#panel, QDockWidget > QWidget { background-color: #12171B; }

/* ---------- docks ---------- */
QDockWidget {
    titlebar-close-icon: none;
    titlebar-normal-icon: none;
    font-size: 12px;
    color: #A7B4BC;
}
QDockWidget::title {
    background-color: #12171B;
    border-bottom: 1px solid #28323A;
    padding-left: 12px;
    height: 30px;
    text-align: left;
}
#dockTitleBar { background-color: #12171B; border-bottom: 1px solid #28323A; }
#dockTitleBar QLabel {
    background: transparent; color: #A7B4BC;
    font-size: 11px; font-weight: 600; letter-spacing: 0.055em; text-transform: uppercase;
}
#dockTitleBar QToolButton {
    background: transparent; border: none; border-radius: 3px;
    padding: 4px; min-width: 18px; min-height: 18px;
}
#dockTitleBar QToolButton:hover { background-color: rgba(255,255,255,0.05); }
#dockTitleBar QToolButton:pressed { background-color: rgba(0,0,0,0.25); }

/* ---------- trees & tables ---------- */
QTreeView, QTableView, QListView {
    background-color: #12171B;
    alternate-background-color: #0D1114;
    border: none;
    outline: 0;
    selection-background-color: #1E3F3C;
    selection-color: #E8EEF1;
    show-decoration-selected: 1;
}
QTreeView::item, QTableView::item, QListView::item {
    min-height: 22px;
    padding: 2px 6px;
    border: 1px solid transparent;
}
QTreeView::item:hover, QTableView::item:hover, QListView::item:hover {
    background-color: rgba(255,255,255,0.05);
}
QTreeView::item:selected, QTableView::item:selected, QListView::item:selected {
    background-color: #1E3F3C;
    color: #E8EEF1;
}
QTreeView::item:selected:active { border: 1px solid #35BDAF; }
QTreeView::branch { background: transparent; }
QTreeView::branch:has-children:closed { image: url(:/icons/chevron-right.svg); }
QTreeView::branch:has-children:open { image: url(:/icons/chevron-down.svg); }

QHeaderView { background-color: #0D1114; border: none; }
QHeaderView::section {
    background-color: #0D1114;
    color: #A7B4BC;
    border: none;
    border-bottom: 1px solid #28323A;
    border-right: 1px solid #28323A;
    padding: 4px 6px;
    font-size: 11px;
    font-weight: 600;
}
QTableCornerButton::section { background-color: #0D1114; border: none; }

/* ---------- tabs ---------- */
QTabWidget::pane { border: none; border-top: 1px solid #28323A; background-color: #12171B; }
QTabBar { background-color: #0D1114; }
QTabBar::tab {
    background-color: transparent;
    color: #A7B4BC;
    border: none;
    border-bottom: 2px solid transparent;
    padding: 6px 12px;
    min-width: 64px;
    font-size: 12px;
}
QTabBar::tab:hover { color: #E8EEF1; background-color: rgba(255,255,255,0.05); }
QTabBar::tab:selected {
    color: #E8EEF1;
    border-bottom: 2px solid #35BDAF;
    background-color: #12171B;
}
QTabBar::tab:disabled { color: #6F7E88; }
QTabBar::close-button { image: url(:/icons/x.svg); subcontrol-position: right; }

/* ---------- toolbars ---------- */
QToolBar {
    background-color: #12171B;
    border: none;
    border-bottom: 1px solid #28323A;
    spacing: 4px;
    padding: 4px 8px;
    min-height: 36px;
}
QToolBar::separator { background-color: #28323A; width: 1px; margin: 4px 6px; }
QToolButton {
    background-color: transparent;
    color: #A7B4BC;
    border: 1px solid transparent;
    border-radius: 3px;
    padding: 4px;
    min-width: 24px; min-height: 24px;
}
QToolButton:hover { background-color: rgba(255,255,255,0.05); color: #E8EEF1; }
QToolButton:pressed { background-color: rgba(0,0,0,0.25); }
QToolButton:checked { background-color: #16302E; border-color: #35BDAF; color: #4FD1C3; }
QToolButton:disabled { color: #6F7E88; }
QToolButton::menu-indicator { image: none; }

/* ---------- buttons ---------- */
QPushButton {
    background-color: #171E23;
    color: #E8EEF1;
    border: 1px solid #33414B;
    border-radius: 3px;
    padding: 0 12px;
    min-height: 24px;
    font-size: 12px;
}
QPushButton:hover { border-color: #4A5A65; background-color: #1D252B; }
QPushButton:pressed { background-color: rgba(0,0,0,0.25); }
QPushButton:focus { border: 1px solid #63D6C9; }
QPushButton:disabled { color: #6F7E88; border-color: #28323A; background-color: #12171B; }
QPushButton[role="primary"] {
    background-color: #35BDAF;
    color: #04211E;
    border: 1px solid #35BDAF;
    font-weight: 600;
}
QPushButton[role="primary"]:hover { background-color: #48CBBE; border-color: #48CBBE; }
QPushButton[role="primary"]:pressed { background-color: #2AA79B; }
QPushButton[role="primary"]:focus { border: 1px solid #63D6C9; }
QPushButton[role="primary"]:disabled {
    background-color: #171E23; color: #6F7E88; border-color: #28323A;
}
QPushButton[role="ghost"] {
    background: transparent; border-color: transparent; color: #A7B4BC;
}
QPushButton[role="ghost"]:hover { background-color: rgba(255,255,255,0.05); color: #E8EEF1; }
QPushButton[role="destructive"] {
    background-color: transparent; border-color: #F07068; color: #F07068;
}
QPushButton[role="destructive"]:hover { background-color: #2E1917; }
QPushButton[role="destructive"]:focus { border: 1px solid #63D6C9; }

/* ---------- inputs ---------- */
QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox {
    background-color: #0A0E11;
    color: #E8EEF1;
    border: 1px solid #33414B;
    border-radius: 3px;
    padding: 0 6px;
    min-height: 24px;
    selection-background-color: #1E3F3C;
    selection-color: #E8EEF1;
}
QLineEdit:hover, QSpinBox:hover, QDoubleSpinBox:hover, QComboBox:hover { border-color: #4A5A65; }
QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus { border-color: #63D6C9; }
QLineEdit:disabled, QSpinBox:disabled, QDoubleSpinBox:disabled, QComboBox:disabled {
    color: #6F7E88; background-color: #12171B; border-color: #28323A;
}
QLineEdit[invalid="true"], QSpinBox[invalid="true"], QDoubleSpinBox[invalid="true"] {
    border-color: #F07068;
}
QComboBox::drop-down { border: none; width: 20px; }
QComboBox::down-arrow { image: url(:/icons/chevron-down.svg); width: 12px; height: 12px; }
QComboBox QAbstractItemView {
    background-color: #1D252B;
    border: 1px solid #33414B;
    selection-background-color: #1E3F3C;
    selection-color: #E8EEF1;
    outline: 0;
}
QSpinBox::up-button, QDoubleSpinBox::up-button,
QSpinBox::down-button, QDoubleSpinBox::down-button {
    background-color: transparent; border: none; width: 16px;
}
QSpinBox::up-arrow, QDoubleSpinBox::up-arrow { image: url(:/icons/chevron-up.svg); width: 9px; height: 9px; }
QSpinBox::down-arrow, QDoubleSpinBox::down-arrow { image: url(:/icons/chevron-down.svg); width: 9px; height: 9px; }

/* ---------- progress ---------- */
QProgressBar {
    background-color: #0A0E11;
    border: none;
    border-radius: 2px;
    height: 4px;
    text-align: center;
    color: #A7B4BC;
    font-size: 10px;
}
QProgressBar::chunk { background-color: #35BDAF; border-radius: 2px; }
QProgressBar[state="processing"]::chunk { background-color: #A78BFA; }
QProgressBar[state="error"]::chunk { background-color: #F07068; }
QProgressBar[state="success"]::chunk { background-color: #48B875; }
QProgressBar[textVisible="true"] { height: 16px; border-radius: 2px; background-color: #0A0E11; }

/* ---------- scrollbars ---------- */
QScrollBar:vertical { background: transparent; width: 10px; margin: 0; }
QScrollBar::handle:vertical {
    background-color: #33414B; min-height: 28px; border-radius: 4px; margin: 2px;
}
QScrollBar::handle:vertical:hover { background-color: #4A5A65; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: transparent; }
QScrollBar:horizontal { background: transparent; height: 10px; margin: 0; }
QScrollBar::handle:horizontal {
    background-color: #33414B; min-width: 28px; border-radius: 4px; margin: 2px;
}
QScrollBar::handle:horizontal:hover { background-color: #4A5A65; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal { background: transparent; }
QScrollArea { border: none; background: transparent; }

/* ---------- menus & tooltips ---------- */
QMenu {
    background-color: #1D252B;
    border: 1px solid #33414B;
    padding: 4px 0;
    color: #E8EEF1;
}
QMenu::item {
    padding: 6px 20px 6px 16px;
    border: 1px solid transparent;
    background: transparent;
}
QMenu::item:selected { background-color: #1E3F3C; border-color: #35BDAF; }
QMenu::item:disabled { color: #6F7E88; }
QMenu::separator { height: 1px; background-color: #28323A; margin: 4px 6px; }
QMenu::icon { padding-left: 16px; }

QToolTip {
    background-color: #1D252B;
    color: #E8EEF1;
    border: 1px solid #33414B;
    padding: 6px 8px;
    font-size: 11px;
}

/* ---------- group boxes / cards ---------- */
QGroupBox {
    background-color: transparent;
    border: 1px solid #28323A;
    border-radius: 4px;
    margin-top: 16px;
    padding: 12px 8px 8px 8px;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 6px;
    padding: 0 4px;
    color: #A7B4BC;
    font-size: 11px;
    font-weight: 600;
}
QFrame[role="card"] {
    background-color: #12171B;
    border: 1px solid #28323A;
    border-radius: 4px;
}
QFrame[role="divider"] { background-color: #28323A; max-height: 1px; border: none; }

/* ---------- check / radio ---------- */
QCheckBox, QRadioButton { background: transparent; spacing: 6px; color: #E8EEF1; }
QCheckBox::indicator, QRadioButton::indicator {
    width: 14px; height: 14px;
    border: 1px solid #4A5A65;
    background-color: #0A0E11;
}
QCheckBox::indicator { border-radius: 2px; }
QRadioButton::indicator { border-radius: 7px; }
QCheckBox::indicator:checked,
QRadioButton::indicator:checked {
    background-color: #35BDAF; border-color: #35BDAF;
    image: url(:/icons/check-contrast.svg);
}
QCheckBox::indicator:disabled, QRadioButton::indicator:disabled {
    border-color: #28323A; background-color: #12171B;
}

/* ---------- status / splitter ---------- */
QStatusBar {
    background-color: #12171B;
    color: #A7B4BC;
    border-top: 1px solid #28323A;
    min-height: 26px;
}
QStatusBar::item { border: none; }
QStatusBar QLabel { color: #A7B4BC; font-size: 11px; background: transparent; }
QSplitter::handle { background-color: #0D1114; }
QSplitter::handle:horizontal { width: 4px; }
QSplitter::handle:vertical { height: 4px; }
QSplitter::handle:hover { background-color: #33414B; }

/* ---------- app-specific ---------- */
#stageRail { background-color: #0D1114; border-right: 1px solid #28323A; }
#stageRail QToolButton { border-radius: 4px; min-width: 32px; min-height: 32px; }
#stageRail QToolButton:checked { background-color: #16302E; border-color: #35BDAF; }
#statusStrip QLabel[role="muted"] { color: #A7B4BC; }
#statusStrip QLabel[role="mono"] { font-family: "JetBrains Mono", monospace; color: #A7B4BC; }
QLabel[role="label"] { color: #A7B4BC; font-size: 11px; font-weight: 600; }
QLabel[role="secondary"] { color: #A7B4BC; }
QLabel[role="mono"] { font-family: "JetBrains Mono", monospace; font-size: 11px; }
QLabel[role="title"] { font-size: 14px; font-weight: 600; }
QLabel[role="dialogTitle"] { font-size: 16px; font-weight: 600; }
QLabel[status="success"] { color: #48B875; }
QLabel[status="warning"] { color: #E3A33C; }
QLabel[status="error"] { color: #F07068; }
QLabel[status="processing"] { color: #A78BFA; }
